# ==========================================
# GTM Lead Enrichment - Local Environment Configuration
# ==========================================

# n8n Local Server Configuration (for docker-compose)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
N8N_BASE_URL=http://localhost:5678

# External Services Reference Values
# (Actual OAuth credentials and API tokens should be saved in n8n's Credential Store)
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
APIFY_ACTOR_ID=compass/crawler-google-places
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN
CLAY_TABLE_WEBHOOK_URL=YOUR_CLAY_TABLE_WEBHOOK_URL
ZOHO_CLIENT_ID=YOUR_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET

# Model Context Protocol (n8n-mcp) Configuration
N8N_API_URL=http://localhost:5678
N8N_API_KEY=YOUR_N8N_API_KEY
